<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    A third library project alongside Utils and Utils.Data, for the same reason Utils.Data exists:
    Utils itself has zero package references and stays that way, so anything cross-cutting that
    genuinely needs one gets its own project rather than dragging a dependency into every consumer.

    Configuration only - no EF Core, no ASP.NET Core, no Permissions. Deciding where a secret comes
    from and whether it is present has nothing to do with HTTP, a database or authorization.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <!-- The file-per-secret provider. Already in the framework, so this is a reference rather than
         a reimplementation - see SecretsConfigurationExtensions. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.KeyPerFile" Version="10.0.0" />
  </ItemGroup>

</Project>
